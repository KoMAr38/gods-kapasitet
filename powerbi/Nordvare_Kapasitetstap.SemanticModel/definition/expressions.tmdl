/// Mappen der src/eksport.py legger dbt-martene. Full sti med skråstrek på slutten.
expression MartMappe = "C:\prosjekt\gods-kapasitet\data\mart\" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: 8e012fb6-5171-470f-a7b0-b0f0ea2754cf

	annotation PBI_ResultType = Text

/// Reservert navn for inkrementell oppdatering. Første dato som lastes i fact_etappe. I tjenesten settes den per partisjon.
expression RangeStart = #datetime(2023, 1, 1, 0, 0, 0) meta [IsParameterQuery=true, Type="DateTime", IsParameterQueryRequired=true]
	lineageTag: c3843020-bd9a-4ece-bbd0-d939aa2ff082

	annotation PBI_ResultType = DateTime

/// Reservert navn for inkrementell oppdatering. Første dato som ikke lastes i fact_etappe.
expression RangeEnd = #datetime(2027, 1, 1, 0, 0, 0) meta [IsParameterQuery=true, Type="DateTime", IsParameterQueryRequired=true]
	lineageTag: 2e370404-f562-460c-be40-8d10c981c3bd

	annotation PBI_ResultType = DateTime

/// Leser en CSV fra MartMappe. Samme funksjon som i vv-demografi og fjordhelse-kvalitet.
expression fnLesCsv =
		let
		    fnLesCsv = (Filnavn as text) as table =>
		        let
		            Kilde = Csv.Document(
		                File.Contents(MartMappe & Filnavn),
		                [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
		            ),
		            Overskrifter = Table.PromoteHeaders(Kilde, [PromoteAllScalars = true])
		        in
		            Overskrifter
		in
		    fnLesCsv
	lineageTag: 936ed751-ae70-47d8-8fb4-6e82562d8487

