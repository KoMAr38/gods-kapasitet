				    Kolonner = Table.SelectColumns(Kilde, {"maaned_start", "fra_fylke_kode", "til_fylke_kode", "kjoretoygruppe_kode", "lager_id", "varegruppe_kode", "etappetype", "antall_etapper", "km", "km_tom", "tonn", "tonnkm", "kapasitet_tonnkm", "tapt_tom_tonnkm", "tapt_delvis_tonnkm"}),
