/// SSB 08478: lastebiltransport per år 1996 til 2025, fire transporttyper. Den lange linjen bak tomkjøringen. Koblet til dim_dato på årsstart.
table fact_ssb_transportytelser_aar
	lineageTag: 257611f8-390c-443d-9769-b07d32b50e03

	column transporttype_kode
		dataType: string
		isHidden
		lineageTag: 01b7d7bb-d443-41f8-85d7-0e7234669d6d
		summarizeBy: none
		sourceColumn: transporttype_kode

	column aar_start
		dataType: dateTime
		isHidden
		formatString: dd.mm.yyyy
		lineageTag: 5872fd77-547a-4bf8-8b3a-facde4c26abe
		summarizeBy: none
		sourceColumn: aar_start

		annotation UnderlyingDateTimeDataType = Date

	column kjoretoykm_mill
		dataType: decimal
		isHidden
		formatString: #,0.0
		isAvailableInMdx: false
		lineageTag: 55b31563-5e51-4d25-9a80-ec3757440f7a
		summarizeBy: none
		sourceColumn: kjoretoykm_mill

	column kjoretoykm_med_last_mill
		dataType: decimal
		isHidden
		formatString: #,0.0
		isAvailableInMdx: false
		lineageTag: d0d6ca20-8bcf-4a58-859d-8885531a1bdf
		summarizeBy: none
		sourceColumn: kjoretoykm_med_last_mill

	column transportmengde_mill_tonn
		dataType: decimal
		isHidden
		formatString: #,0.0
		isAvailableInMdx: false
		lineageTag: b03109cf-6ae0-4adb-b710-011d18892119
		summarizeBy: none
		sourceColumn: transportmengde_mill_tonn

	column transportarbeid_mill_tonnkm
		dataType: decimal
		isHidden
		formatString: #,0
		isAvailableInMdx: false
		lineageTag: e267555d-316a-488d-ba9e-185737e25f24
		summarizeBy: none
		sourceColumn: transportarbeid_mill_tonnkm

	partition fact_ssb_transportytelser_aar = m
		mode: import
		source =
				let
				    Kilde = fnLesCsv("fact_ssb_transportytelser_aar.csv"),
				    Kolonner = Table.SelectColumns(Kilde, {"transporttype_kode", "aar_start", "kjoretoykm_mill", "kjoretoykm_med_last_mill", "transportmengde_mill_tonn", "transportarbeid_mill_tonnkm"}),
				    Typer = Table.TransformColumnTypes(Kolonner, {{"aar_start", type date}, {"kjoretoykm_mill", Currency.Type}, {"kjoretoykm_med_last_mill", Currency.Type}, {"transportmengde_mill_tonn", Currency.Type}, {"transportarbeid_mill_tonnkm", Currency.Type}}, "en-US")
				in
				    Typer

