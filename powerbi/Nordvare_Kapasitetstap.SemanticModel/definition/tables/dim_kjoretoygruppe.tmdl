/// Tre kjøretøygrupper med fast nyttelast.
table dim_kjoretoygruppe
	lineageTag: 428477a7-e314-4ad2-8dac-f96cd629f6cd

	column kjoretoygruppe_kode
		dataType: string
		isHidden
		lineageTag: 83d7e428-54b1-4f65-97fd-72197da3802b
		summarizeBy: none
		sourceColumn: kjoretoygruppe_kode

	/// Distribusjonsbil, semitrailer eller modulvogntog.
	column Kjøretøygruppe
		dataType: string
		lineageTag: 9a9d6d4e-faf5-4d92-8afb-eb7ce01d8fa7
		summarizeBy: none
		sourceColumn: kjoretoygruppe_navn
		sortByColumn: Sortering

	/// Nyttelast per bil i gruppen.
	column 'Nyttelast tonn'
		dataType: int64
		formatString: 0
		lineageTag: 716bff40-d5fd-4e0d-9c08-5d00787d4851
		summarizeBy: none
		sourceColumn: nyttelast_tonn

	/// Hva gruppen brukes til hos Nordvare.
	column 'Typisk bruk'
		dataType: string
