	partition dim_kjoretoygruppe = m
		mode: import
		source =
				let
				    Kilde = fnLesCsv("dim_kjoretoygruppe.csv"),
				    Kolonner = Table.SelectColumns(Kilde, {"kjoretoygruppe_kode", "kjoretoygruppe_navn", "nyttelast_tonn", "typisk_bruk", "sortering"}),
				    Typer = Table.TransformColumnTypes(Kolonner, {{"nyttelast_tonn", Int64.Type}, {"sortering", Int64.Type}}, "en-US")
				in
				    Typer

